#!/usr/bin/env python3

import json
import os
import subprocess
import sys
from datetime import datetime, timedelta, timezone
from zoneinfo import ZoneInfo, ZoneInfoNotFoundError


def usage(message=None):
    if message:
        print(f"localized-events: {message}", file=sys.stderr)
    print(
        "usage: localized-events CALDIR DAYS_AHEAD [TIMEZONE]",
        file=sys.stderr,
    )
    raise SystemExit(2)


def system_zone():
    try:
        target = os.path.realpath("/etc/localtime")
        marker = "/zoneinfo/"
        if marker in target:
            name = target.split(marker, 1)[1]
            return ZoneInfo(name), name
        with open("/etc/localtime", "rb") as zone_file:
            return ZoneInfo.from_file(zone_file), "system"
    except (OSError, ValueError, ZoneInfoNotFoundError):
        local = datetime.now().astimezone().tzinfo
        return local, str(local or "system")


def requested_zone(name):
    if not name:
        return system_zone()
    try:
        return ZoneInfo(name), name
    except (OSError, ValueError, ZoneInfoNotFoundError):
        usage(f"unknown timezone: {name}")


def parse_instant(value):
    if not isinstance(value, str):
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None


def wall_millis(value, zone, all_day=False):
    parsed = parse_instant(value)
    if parsed is None:
        return None
    if all_day:
        local = parsed
    else:
        if parsed.tzinfo is None:
            return None
        local = parsed.astimezone(zone)
    wall = datetime(
        local.year,
        local.month,
        local.day,
        local.hour,
        local.minute,
        local.second,
        local.microsecond,
        tzinfo=timezone.utc,
    )
    return round(wall.timestamp() * 1000)


def main():
    if len(sys.argv) not in (3, 4):
        usage()

    caldir = sys.argv[1]
    try:
        days_ahead = int(sys.argv[2])
    except ValueError:
        usage("DAYS_AHEAD must be an integer")
    if days_ahead < 1 or days_ahead > 30:
        usage("DAYS_AHEAD must be between 1 and 30")

    zone, zone_name = requested_zone(sys.argv[3] if len(sys.argv) == 4 else None)
    now = datetime.now(zone)
    range_start = now.date()
    range_end = range_start + timedelta(days=days_ahead)
    command = [
        caldir,
        "events",
        "--json",
        "--from",
        range_start.isoformat(),
        "--to",
        range_end.isoformat(),
    ]
    try:
        result = subprocess.run(command, capture_output=True, check=False)
    except OSError as error:
        print(f"localized-events: could not run caldir: {error}", file=sys.stderr)
        return 1
    if result.returncode != 0:
        sys.stderr.buffer.write(result.stderr)
        return result.returncode

    try:
        events = json.loads(result.stdout)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        print(f"localized-events: invalid caldir JSON: {error}", file=sys.stderr)
        return 1
    if not isinstance(events, list):
        print("localized-events: caldir JSON must be an array", file=sys.stderr)
        return 1

    offset = now.utcoffset() or timedelta(0)
    current_offset_ms = round(offset.total_seconds() * 1000)
    for event in events:
        if not isinstance(event, dict):
            continue
        all_day = event.get("all_day") is True
        event["_viewer"] = {
            "timezone": zone_name,
            "current_offset_ms": current_offset_ms,
            "start_wall_ms": wall_millis(event.get("start"), zone, all_day),
            "end_wall_ms": wall_millis(event.get("end"), zone, all_day),
        }

    json.dump(events, sys.stdout, separators=(",", ":"))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
