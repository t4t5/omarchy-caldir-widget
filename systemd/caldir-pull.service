[Unit]
Description=Pull remote calendars for Omarchy Caldir Widget
Documentation=https://caldir.org/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# User units have a small default PATH. Include common locations used by
# caldir's installer, Cargo, pipx, and system packages.
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env caldir pull
