{
  "schemaVersion": 1,
  "id": "omarchy-caldir",
  "name": "Omarchy Caldir Widget",
  "version": "1.0.0",
  "author": "t4t5",
  "license": "MIT",
  "description": "A caldir-powered meeting countdown and multi-day schedule",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Omarchy Caldir Widget",
    "description": "Shows the next event in the bar and a schedule on click",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "daysAhead": 3,
      "calendar": "",
      "showOnlyWithVideoLink": true,
      "maxTitleLength": 28,
      "openScript": ""
    },
    "schema": [
      {
        "key": "daysAhead",
        "type": "integer",
        "label": "Days ahead",
        "min": 1,
        "max": 30,
        "defaultValue": 3
      },
      {
        "key": "calendar",
        "type": "string",
        "label": "Calendar slug",
        "defaultValue": "",
        "description": "Optional caldir calendar slug. Leave blank to include every calendar."
      },
      {
        "key": "showOnlyWithVideoLink",
        "type": "boolean",
        "label": "Only meetings with video links",
        "defaultValue": true
      },
      {
        "key": "maxTitleLength",
        "type": "integer",
        "label": "Maximum bar label length",
        "min": 8,
        "max": 80,
        "defaultValue": 28
      },
      {
        "key": "openScript",
        "type": "string",
        "label": "Event-open script",
        "defaultValue": "",
        "description": "Path to a custom event-open script. Leave blank for the bundled default."
      }
    ]
  }
}
