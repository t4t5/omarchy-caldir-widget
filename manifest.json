{
  "schemaVersion": 1,
  "id": "org.ren.caldir",
  "name": "Caldir Calendar",
  "version": "1.0.0",
  "author": "t4t5",
  "license": "MIT",
  "description": "Quick access to your next calendar events.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Caldir Calendar",
    "description": "Shows the next meeting in the bar and your agenda on click",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "daysAhead": 2
    },
    "schema": [
      {
        "key": "daysAhead",
        "type": "integer",
        "label": "Days ahead",
        "min": 1,
        "max": 30,
        "defaultValue": 2
      }
    ]
  }
}
