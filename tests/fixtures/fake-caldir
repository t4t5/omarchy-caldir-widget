#!/usr/bin/env bash
set -eu
case "$1" in
  invites) printf '[]\n' ;;
  status)
    [[ "$2" == --calendar ]]
    sleep 0.2
    case "$3" in
      settled) printf '📅 settled\n\033[2m   No changes\033[0m\n' ;;
      incoming) printf '📅 incoming\n\033[2m   Remote changes (to pull):\033[0m\n   + New meeting Today, 14:30\n' ;;
      offline) printf '📅 offline\n   Provider failed: offline\n' ;;
      *) printf '📅 %s\n   Local changes (to push):\n   ~ Planning\n' "$3" ;;
    esac
    ;;
  rsvp)
    [[ "$2" == -- && "$3" == /tmp/widget-invite.ics ]]
    [[ "$4" == accept || "$4" == decline || "$4" == maybe ]]
    ;;
  push)
    [[ "$2" == --calendar ]]
    # Leave time for the QML tests to observe the in-flight send state.
    sleep 0.2
    if [[ "$3" == noop ]]; then
      printf '📅 noop\n\033[2m   No changes to push\033[0m\n'
    elif [[ "$3" == offline ]]; then
      printf 'Provider failed: offline\n'
    else
      printf 'Pushed: 0 created, 1 updated, 0 deleted\n'
    fi
    ;;
  *) exit 1 ;;
esac
